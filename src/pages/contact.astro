---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | nursinghomeneglectcalc.com';
const description = 'Contact the editorial team at nursinghomeneglectcalc.com for corrections, feedback, or questions about the calculator and guides.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>For corrections, feedback, or questions about the calculator or guides, email the editorial team at <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>

  <h2>What We Can Help With</h2>
  <p>We respond to: factual corrections (incorrect statute citations, outdated CMS regulatory requirements, damages baselines that don't match documented verdict patterns — include the specific claim and your source); feedback on calculator or guide content; and questions about methodology or editorial standards. Corrections are reviewed within five business days.</p>

  <h2>What We Cannot Help With</h2>
  <p>We cannot provide legal advice, evaluate a specific nursing home situation, or advise on whether to file a claim. For case-specific assistance: consult an elder abuse attorney (most work on contingency or fee-shifting basis with no upfront cost); contact your state's Long-Term Care Ombudsman (free investigation and advocacy); or file a report with Adult Protective Services.</p>

  <p>Return to the <a href="/">calculator</a> or see the <a href="/about">about page</a>.</p>
</BaseLayout>
